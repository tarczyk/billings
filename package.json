{
  "name": "billings",
  "version": "1.0.0",
  "private": true,
  "description": "Google Apps Script – odczyt liczników mediów (prąd, woda, c.o.) ze zdjęć",
  "scripts": {
    "login": "clasp login",
    "pull": "clasp pull",
    "push": "clasp push",
    "open": "clasp open-script",
    "deploy": "clasp deploy",
    "run": "clasp run przetworzNoweLiczniki",
    "rozliczenia:status": "clasp -P bound-scripts/rozliczenie-najem show-file-status",
    "rozliczenia:pull": "clasp -P bound-scripts/rozliczenie-najem pull",
    "rozliczenia:push": "clasp -P bound-scripts/rozliczenie-najem push",
    "rozliczenia:open": "clasp -P bound-scripts/rozliczenie-najem open-script"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^1.0.97"
  }
}
